{
  "name": "@wirex/stellar-sdk",
  "version": "0.1.0",
  "description": "Modular, ecosystem-reusable SDK for the Stellar blockchain",
  "author": "Vottun <dev@vottun.com>",
  "license": "MIT",
  "keywords": [
    "stellar",
    "blockchain",
    "sdk",
    "payments",
    "soroban",
    "wirex",
    "vottun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vottunio/stellar-sdk"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "browser": "dist/umd/wirex-sdk.umd.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "clean": "rm -rf dist coverage docs/api",
    "size": "node scripts/bundle-size.js",
    "size:check": "node scripts/bundle-size.js --check",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "axios": "^1.7.9",
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "rollup": "^4.28.0",
    "rollup-plugin-dts": "^6.1.1",
    "ts-jest": "^29.2.0",
    "tslib": "^2.8.0",
    "typedoc": "^0.28.18",
    "typescript": "^5.7.0"
  }
}
