# ════════════════════════════════════════════════════════════════════════
#  @wirex/stellar-sdk — Environment Variables
# ════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and fill in real values for the variables you
# need. The `.env` file is gitignored — never commit real credentials.
#
# Usage with the mainnet-proof script:
#   cp .env.example .env
#   # edit .env, then:
#   nvm use 22
#   npx tsx --env-file=.env scripts/mainnet-proof.ts
#
# Node 20.6+ supports `--env-file=` natively. For older Node, source the
# file in your shell first:
#   set -a && source .env && set +a
#   npx tsx scripts/mainnet-proof.ts
#
# ════════════════════════════════════════════════════════════════════════
#  Mainnet Proof Transaction (scripts/mainnet-proof.ts — SCF acceptance 3.4.8)
# ════════════════════════════════════════════════════════════════════════

# Source wallet — set ONE of the following two.
# If both are set, MAINNET_MNEMONIC wins.

# Option A: BIP39 mnemonic (12 or 24 words, space-separated, in quotes).
# Derivation path follows SEP-0005: m/44'/148'/{MAINNET_DERIVE_INDEX}'
MAINNET_MNEMONIC=""

# Option B: Stellar secret key (starts with S, 56 chars).
# MAINNET_SECRET="S....."
MAINNET_SECRET=""

# HD derivation index when using a mnemonic. Default 0 = first account.
MAINNET_DERIVE_INDEX="0"

# Destination — required. Either:
#   - A Stellar G... public key on mainnet
#   - The literal string "self" to send to the source account (proof-only)
MAINNET_DEST="self"

# Amount to send, in XLM. Default 0.0001 (= 0.000016 USD at $0.16/XLM).
# Use a small amount — the goal is proof of mainnet connectivity, not value transfer.
MAINNET_AMOUNT="0.0001"

# Set to "1" to rehearse the flow without actually submitting.
# Recommended for the first run.
MAINNET_DRY_RUN=""

